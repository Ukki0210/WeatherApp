@code {
    [Parameter]
    public string City { get; set; } = "";

    private ForecastData? forecastData;
    private bool isLoading = false;
    private string? errorMessage;
    private string temperatureUnit = "Celsius";

    protected override async Task OnInitializedAsync()
    {
        await LoadTemperaturePreference();
        await LoadForecast();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender && forecastData != null && forecastData.Forecasts.Any())
        {
            await Task.Delay(200);
            await RenderCharts();
        }
    }

    private async Task LoadTemperaturePreference()
    {
        try
        {
            var savedUnit = await JS.InvokeAsync<string>("localStorage.getItem", "temperatureUnit");
            if (!string.IsNullOrEmpty(savedUnit))
            {
                temperatureUnit = savedUnit;
                Console.WriteLine($"✅ Loaded temperature unit: {temperatureUnit}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading temperature preference: {ex.Message}");
        }
    }

    private string FormatTemperature(double celsius)
    {
        try
        {
            var temp = TemperatureConverter.Convert(celsius, temperatureUnit);
            var symbol = TemperatureConverter.GetUnitSymbol(temperatureUnit);
            return $"{Math.Round(temp)}{symbol}";
        }
        catch
        {
            return $"{Math.Round(celsius)}°C";
        }
    }

    private async Task LoadForecast()
    {
        if (string.IsNullOrWhiteSpace(City))
        {
            errorMessage = "City name is required";
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            forecastData = await WeatherApi.GetForecastAsync(City);

            if (forecastData == null || !forecastData.Forecasts.Any())
            {
                errorMessage = $"Could not load forecast for {City}";
            }
            else
            {
                Console.WriteLine($"✅ Loaded {forecastData.Forecasts.Count} forecast items");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            Console.WriteLine($"❌ Forecast error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RenderCharts()
    {
        try
        {
            if (forecastData == null || !forecastData.Forecasts.Any())
            {
                Console.WriteLine("⚠️ No forecast data to render charts");
                return;
            }

            Console.WriteLine($"📊 Starting forecast chart rendering with {forecastData.Forecasts.Count} data points");

            // Group by day and take average per day for cleaner charts
            var dailyGroups = forecastData.Forecasts
                .GroupBy(f => f.DateTime.Date)
                .Select(g => new
                {
                    Date = g.Key,
                    AvgTemp = g.Average(f => f.Temperature),
                    AvgHumidity = g.Average(f => f.Humidity),
                    AvgWind = g.Average(f => f.WindSpeed),
                    RainProb = g.Any(f => f.RainVolume > 0) ? 80.0 : 20.0
                })
                .OrderBy(d => d.Date)
                .Take(5)
                .ToList();

            if (!dailyGroups.Any())
            {
                Console.WriteLine("⚠️ No daily groups created");
                return;
            }

            var dates = dailyGroups.Select(d => d.Date.ToString("MMM dd")).ToArray();
            var temperatures = dailyGroups.Select(d => TemperatureConverter.Convert(d.AvgTemp, temperatureUnit)).ToArray();
            var humidity = dailyGroups.Select(d => d.AvgHumidity).ToArray();
            var windSpeed = dailyGroups.Select(d => d.AvgWind).ToArray();
            var rainProb = dailyGroups.Select(d => d.RainProb).ToArray();
            var tempSymbol = TemperatureConverter.GetUnitSymbol(temperatureUnit);

            Console.WriteLine($"Dates: {string.Join(", ", dates)}");
            Console.WriteLine($"Temperatures: {string.Join(", ", temperatures)}");

            await JS.InvokeVoidAsync("createForecastCharts",
                dates, temperatures, humidity, windSpeed, rainProb, tempSymbol);

            Console.WriteLine("✅ Forecast charts rendered successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error rendering charts: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
        }
    }

    private Dictionary<DateTime, List<ForecastItem>> GroupForecastsByDay()
    {
        if (forecastData == null || forecastData.Forecasts == null)
            return new Dictionary<DateTime, List<ForecastItem>>();

        return forecastData.Forecasts
            .GroupBy(f => f.DateTime.Date)
            .OrderBy(g => g.Key)
            .Take(5)
            .ToDictionary(g => g.Key, g => g.OrderBy(f => f.DateTime).ToList());
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }

    private string GetWeatherEmoji(string iconCode)
    {
        return iconCode switch
        {
            "01d" => "☀️",
            "01n" => "🌙",
            "02d" => "⛅",
            "02n" => "☁️",
            "03d" or "03n" => "☁️",
            "04d" or "04n" => "☁️",
            "09d" or "09n" => "🌧️",
            "10d" => "🌦️",
            "10n" => "🌧️",
            "11d" or "11n" => "⛈️",
            "13d" or "13n" => "❄️",
            "50d" or "50n" => "🌫️",
            _ => "🌤️"
        };
    }

    private string GetAverageTemp()
    {
        if (forecastData == null || !forecastData.Forecasts.Any()) return "N/A";
        var avg = forecastData.Forecasts.Average(f => f.Temperature);
        return FormatTemperature(avg);
    }

    private string GetHighestTemp()
    {
        if (forecastData == null || !forecastData.Forecasts.Any()) return "N/A";
        var max = forecastData.Forecasts.Max(f => f.Temperature);
        return FormatTemperature(max);
    }

    private string GetLowestTemp()
    {
        if (forecastData == null || !forecastData.Forecasts.Any()) return "N/A";
        var min = forecastData.Forecasts.Min(f => f.Temperature);
        return FormatTemperature(min);
    }

    private int GetAverageHumidity()
    {
        if (forecastData == null || !forecastData.Forecasts.Any()) return 0;
        return (int)forecastData.Forecasts.Average(f => f.Humidity);
    }
}
