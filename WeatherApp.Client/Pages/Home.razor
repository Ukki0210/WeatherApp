@code {
    private string searchCity = "";
    private ActiveWeatherAlert? currentAlert;
    private bool notificationPermissionGranted = false;

    private WeatherData? currentWeather;
    private List<TopCity> topCities = new();
    private bool isLoading = false;
    private bool isLoadingLocation = false;
    private bool isLoadingCities = false;
    private bool isLoadingAI = false;
    private string? errorMessage;
    private string? aiInsights;
    private string temperatureUnit = "Celsius";

    // Video background variables
    private string currentVideoPath = "videos/sunny.mp4";
    private string currentWeatherCondition = "";
    private int videoKey = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadTemperaturePreference();
        await LoadTopCities();
    }

    // UPDATED: Only show SEVERE alerts (Warning or Critical)
    private async Task CheckForAlerts(string city)
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<ActiveWeatherAlert>>($"api/alerts/{city}");
            
            if (response != null && response.Any())
            {
                // Only show SEVERE alerts (Warning or Critical)
                currentAlert = response
                    .Where(a => a.EndTime > DateTime.UtcNow && 
                               (a.Severity == "Warning" || a.Severity == "Critical"))
                    .OrderByDescending(a => GetSeverityPriority(a.Severity))
                    .FirstOrDefault();

                // Show browser notification for severe alerts
                if (currentAlert != null)
                {
                    await ShowBrowserNotification(currentAlert);
                }
            }
            else
            {
                // No alerts - clear current alert
                currentAlert = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching alerts: {ex.Message}");
            currentAlert = null;
        }
    }

    private async Task ShowBrowserNotification(ActiveWeatherAlert alert)
    {
        try
        {
            if (!notificationPermissionGranted)
            {
                var permission = await JS.InvokeAsync<string>("requestNotificationPermission");
                notificationPermissionGranted = permission == "granted";
            }

            if (notificationPermissionGranted)
            {
                await JS.InvokeVoidAsync("showNotification", alert.Title, alert.Description);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error showing notification: {ex.Message}");
        }
    }

    // UPDATED: Added Critical priority level
    private int GetSeverityPriority(string severity)
    {
        return severity switch
        {
            "Critical" => 4,    // Extreme danger (>=45°C, <=-15°C, etc.)
            "Warning" => 3,     // Severe conditions (>=40°C, <=-10°C, etc.)
            "Watch" => 2,       // Moderate conditions
            "Advisory" => 1,    // Minor conditions
            _ => 0
        };
    }

    // NEW: Get CSS class for alert severity
    private string GetAlertSeverityClass(string severity)
    {
        return severity.ToLower() switch
        {
            "critical" => "critical",
            "warning" => "warning",
            _ => ""
        };
    }

    // NEW: Get appropriate icon for severity level
    private string GetAlertIcon(string severity)
    {
        return severity switch
        {
            "Critical" => "🚨",     // Red siren for critical
            "Warning" => "⚠️",      // Warning triangle for severe
            "Watch" => "👁️",        // Eye for watch
            "Advisory" => "ℹ️",     // Info for advisory
            _ => "⚠️"
        };
    }

    private void DismissAlert()
    {
        currentAlert = null;
    }

    private async Task LoadTemperaturePreference()
    {
        try
        {
            var savedUnit = await JS.InvokeAsync<string>("localStorage.getItem", "temperatureUnit");
            if (!string.IsNullOrEmpty(savedUnit))
            {
                temperatureUnit = savedUnit;
                Console.WriteLine($"✅ Home - Loaded temperature unit: {temperatureUnit}");
            }
            else
            {
                Console.WriteLine("⚠️ Home - No temperature unit saved, using default: Celsius");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Home - Error loading temperature preference: {ex.Message}");
        }
    }

    private string FormatTemperature(double celsius)
    {
        try
        {
            var temp = TemperatureConverter.Convert(celsius, temperatureUnit);
            var symbol = TemperatureConverter.GetUnitSymbol(temperatureUnit);
            return $"{Math.Round(temp)}{symbol}";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Home - Error formatting temperature: {ex.Message}");
            return $"{Math.Round(celsius)}°C"; // Fallback
        }
    }

    private async Task GetAIInsights()
    {
        if (currentWeather == null) return;

        isLoadingAI = true;
        aiInsights = null;

        try
        {
            var request = new WeatherInsightRequest
                {
                    CityName = currentWeather.City,
                    Temperature = currentWeather.Temperature,
                    FeelsLike = currentWeather.FeelsLike,
                    Condition = currentWeather.Description,
                    Humidity = currentWeather.Humidity,
                    WindSpeed = currentWeather.WindSpeed,
                    Visibility = currentWeather.Visibility
                };

            aiInsights = await AIWeatherService.GetWeatherInsightsAsync(request);
        }
        catch (Exception ex)
        {
            aiInsights = $"Error generating insights: {ex.Message}";
        }
        finally
        {
            isLoadingAI = false;
        }
    }

    private string FormatAIInsights(string insights)
    {
        if (string.IsNullOrEmpty(insights))
            return "";

        // Split by the section headers
        var sections = insights.Split(new[] { "**" }, StringSplitOptions.RemoveEmptyEntries);

        var formatted = new StringBuilder();

        for (int i = 0; i < sections.Length; i++)
        {
            var section = sections[i].Trim();
            if (string.IsNullOrEmpty(section))
                continue;

            // Check if this is a header
            if (section.Contains("Weather Overview"))
            {
                formatted.Append("<div class='insight-section overview'>");
                formatted.Append("<div class='insight-title'><span class='icon'>🌤️</span>Weather Overview</div>");
                if (i + 1 < sections.Length)
                {
                    formatted.Append($"<p class='insight-text'>{sections[++i].Trim()}</p>");
                }
                formatted.Append("</div>");
            }
            else if (section.Contains("Activity Recommendations"))
            {
                formatted.Append("<div class='insight-section activities'>");
                formatted.Append("<div class='insight-title'><span class='icon'>⚽</span>Activity Recommendations</div>");
                if (i + 1 < sections.Length)
                {
                    formatted.Append($"<p class='insight-text'>{sections[++i].Trim()}</p>");
                }
                formatted.Append("</div>");
            }
            else if (section.Contains("Clothing Advice"))
            {
                formatted.Append("<div class='insight-section clothing'>");
                formatted.Append("<div class='insight-title'><span class='icon'>👕</span>Clothing Advice</div>");
                if (i + 1 < sections.Length)
                {
                    formatted.Append($"<p class='insight-text'>{sections[++i].Trim()}</p>");
                }
                formatted.Append("</div>");
            }
            else if (section.Contains("Health & Safety"))
            {
                formatted.Append("<div class='insight-section safety'>");
                formatted.Append("<div class='insight-title'><span class='icon'>🏥</span>Health & Safety Tips</div>");
                if (i + 1 < sections.Length)
                {
                    formatted.Append($"<p class='insight-text'>{sections[++i].Trim()}</p>");
                }
                formatted.Append("</div>");
            }
        }

        return formatted.ToString();
    }

    private async Task SearchWeather()
    {
        if (string.IsNullOrWhiteSpace(searchCity))
        {
            errorMessage = "Please enter a city name";
            return;
        }

        isLoading = true;
        errorMessage = null;
        currentAlert = null;
        aiInsights = null;

        try
        {
            var userId = AuthService.IsAuthenticated ? AuthService.CurrentUserId : null;
            currentWeather = await WeatherApi.GetCurrentWeatherAsync(searchCity, userId);

            if (currentWeather == null)
            {
                errorMessage = $"Could not find weather data for '{searchCity}'";
            }
            else
            {
                currentWeatherCondition = currentWeather.Icon;
                UpdateVideoBackground();
                await CheckForAlerts(searchCity);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GetLocationWeather()
    {
        isLoadingLocation = true;
        errorMessage = null;
        currentAlert = null;
        aiInsights = null;

        try
        {
            var position = await JS.InvokeAsync<GeolocationPosition>("getLocation");

            var userId = AuthService.IsAuthenticated ? AuthService.CurrentUserId : null;
            currentWeather = await WeatherApi.GetWeatherByCoordinatesAsync(
                position.Coords.Latitude,
                position.Coords.Longitude,
                userId);

            if (currentWeather != null)
            {
                searchCity = currentWeather.City;
                currentWeatherCondition = currentWeather.Icon;
                UpdateVideoBackground();
                await CheckForAlerts(currentWeather.City);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error getting location: {ex.Message}";
        }
        finally
        {
            isLoadingLocation = false;
        }
    }

     private void UpdateVideoBackground()
    {
        var icon = currentWeatherCondition.ToLower();

        // Map OpenWeatherMap icons to your available videos:
        // Available: sunny.mp4, cloudy.mp4, rain.mp4, snowy.mp4, fog.mp4, night-clear.mp4
        
        currentVideoPath = icon switch
        {
            // Clear sky - day
            "01d" => "videos/sunny.mp4",
            
            // Clear sky - night
            "01n" => "videos/night-clear.mp4",
            
            // Any clouds (few, scattered, broken, overcast)
            "02d" or "02n" or "03d" or "03n" or "04d" or "04n" => "videos/cloudy.mp4",
            
            // Rain, drizzle, shower
            "09d" or "09n" or "10d" or "10n" => "videos/rain.mp4",
            
            // Thunderstorm (use rain video since you don't have stormy)
            "11d" or "11n" => "videos/rain.mp4",
            
            // Snow
            "13d" or "13n" => "videos/snowy.mp4",
            
            // Mist, fog, haze
            "50d" or "50n" => "videos/fog.mp4",
            
            // Default fallback
            _ => "videos/sunny.mp4"
        };

        videoKey++; // Force video reload
    }

    private async Task LoadTopCities()
    {
        isLoadingCities = true;

        try
        {
            topCities = await WeatherApi.GetTopCitiesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading top cities: {ex.Message}");
        }
        finally
        {
            isLoadingCities = false;
        }
    }

    private async Task SearchWeatherByCity(string cityName)
    {
        searchCity = cityName;
        await SearchWeather();
    }

    private string GetWeatherEmoji(string icon)
    {
        return icon switch
        {
            "01d" => "☀️",
            "01n" => "🌙",
            "02d" => "⛅",
            "02n" => "☁️",
            "03d" or "03n" => "☁️",
            "04d" or "04n" => "☁️",
            "09d" or "09n" => "🌧️",
            "10d" => "🌦️",
            "10n" => "🌧️",
            "11d" or "11n" => "⛈️",
            "13d" or "13n" => "❄️",
            "50d" or "50n" => "🌫️",
            _ => "🌤️"
        };
    }

    private void ViewForecast()
    {
        if (currentWeather != null)
        {
            Navigation.NavigateTo($"/forecast/{currentWeather.City}");
        }
    }

    private async Task AddToFavorites()
{
    if (currentWeather == null || !AuthService.IsAuthenticated)
        return;

    try
    {
        var userId = AuthService.CurrentUserId;
        if (string.IsNullOrEmpty(userId))
        {
            errorMessage = "User not authenticated";
            return;
        }

        await UserProfileApi.AddFavoriteCityAsync(userId, currentWeather.City);
        // Show success message (you can add a toast notification here)
        Console.WriteLine($"✅ Added {currentWeather.City} to favorites");
    }
    catch (Exception ex)
    {
        errorMessage = $"Error adding to favorites: {ex.Message}";
        Console.WriteLine($"❌ Error: {ex.Message}");
    }
}


    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchWeather();
        }
    }

    // GeolocationPosition helper class
    public class GeolocationPosition
    {
        public GeolocationCoords Coords { get; set; } = new();
    }

    public class GeolocationCoords
    {
        public double Latitude { get; set; }
